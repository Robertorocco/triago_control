<?xml version="1.0"?>
<model>
  <name>apriltag36_11_00</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>triago_control</name>
    <email>-</email>
  </author>

  <description>
    A single printable AprilTag (family 36h11, id 0) rendered as a flat plate.
    The texture (materials/textures/apriltag36_11_00.png) is a genuine tag36h11
    id-0 pattern generated from the upstream AprilTag family definition and
    verified detectable by ViSP's vpDetectorAprilTag. The PNG is directly
    printable for use with the real robot.

    Geometry: the textured plate is 0.15 x 0.15 m; the tag PNG has a 1-cell
    white quiet zone, so the black-bordered square (the "tag_size" ViSP
    estimates the pose of) is 0.8 * 0.15 = 0.12 m. Use tag_size = 0.12 m in the
    visp_apriltag node.
  </description>
</model>
