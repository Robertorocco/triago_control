<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: same tuning as the other worlds.
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         BIMANUAL HANDOVER SCENARIO
         A vertical DIVIDER cuts the main work table in half along y=0,
         separating the LEFT half (y>0, blue cylinder) from the RIGHT half
         (y<0, red cylinder). The intended task: the LEFT hand picks the blue
         cylinder, lifts it over the divider and sets it on the HANDOVER
         platform on the right half; the RIGHT hand then picks it up and places
         it on the FINAL platform on a separate smaller side table to the right.

         Both the HANDOVER platform (yellow) and the FINAL platform (green, on the
         side table) are REAL Platform_* goals on the QP/belief/guidance side (see
         handover_world.yaml's `platforms:` list): each is demandable by either
         arm while it holds a cylinder. These Gazebo disks are the operator's
         visual aids for those goals.
    ================================================================ -->

    <!-- Main work table: same pose/size/material as the other worlds. -->
    <model name="work_table">
      <static>true</static>
      <pose>1.000 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table divider: a vertical wall standing on the main table at y=0,
         spanning the table's x extent, 0.20 m tall (top at z=0.90). Splits the
         table into a LEFT half (y>0) and a RIGHT half (y<0). -->
    <model name="table_divider">
      <static>true</static>
      <pose>1.000 0.0 0.80 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.03 0.20</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.03 0.20</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Side table (smaller, further right): RIGHT of the main table (y=-0.85).
         Carries the FINAL placement platform for the right hand. -->
    <model name="side_table">
      <static>true</static>
      <pose>0.900 -0.85 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- HANDOVER platform (yellow): on the RIGHT half of the main table, just
         right of the divider. The LEFT hand sets the blue cylinder here; the
         RIGHT hand picks it up. This is the single functional Platform_Place
         goal (see handover_world.yaml's `platform:` field). Smaller disk. -->
    <model name="placement_area">
      <static>true</static>
      <pose>1.000 -0.12 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.09</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- FINAL platform (green): on the side table (y=-0.85), r=0.10. Where the
         RIGHT hand ultimately places the cylinder. Real Platform_Final goal (see
         handover_world.yaml's `platforms:` list). -->
    <model name="placement_area_final">
      <static>true</static>
      <pose>0.900 -0.85 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.10</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         RED CYLINDER, right arm manipulandum (right half). Unchanged pose.
    ================================================================ -->
    <model name="red_cylinder">
      <static>false</static>
      <pose>0.800 -0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BLUE CYLINDER, left arm manipulandum (left half). Unchanged pose.
    ================================================================ -->
    <model name="blue_cylinder">
      <static>false</static>
      <pose>0.800 0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
