<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: same tuning as no_obstacle.world, kept identical. No
         cylinders exist in this world to tip or settle, but nothing here
         depends on the physics constants specifically, so no reason to
         diverge from the shared baseline.
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         WORK TABLE: same pose, size, and material as no_obstacle.world's
         work_table. This is the ONLY obstacle in this world (movement
         tutorial; no graspable cylinders, no other clutter).
    ================================================================ 
    <model name="work_table">
      <static>true</static>
      <pose>1.000 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- ================================================================
         RED / BLUE TARGET MARKERS. Visual only: no collision, no mass,
         no LinkAttacher relevance. These purely mark, in the simulated
         world, where the two "Front" reach/hover goals actually are, so
         the user can visually confirm the ghost-gripper RViz markers
         (which are what the shared-autonomy belief pipeline actually
         renders) line up with something real in the scene. They
         deliberately have NO collision block, matching
         config/worlds/movement_tutorial.yaml's red_target/blue_target
         entries, which are also collision:false.

         Poses (base_footprint / world, robot at origin). Moved 20cm closer
         to the robot (x) and 20cm closer to the table (z) from the
         original x=1.0/z=1.20, after that pose was reported physically
         unreachable:
           red_target:  x=0.80, y=-0.45, z=1.00
           blue_target: mirrored on y=+0.45
    ================================================================ -->
    <model name="red_target">
      <static>true</static>
      <pose>0.80 -0.45 1.00 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="blue_target">
      <static>true</static>
      <pose>0.80 0.45 1.00 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
