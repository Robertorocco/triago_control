<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: same tuning as no_obstacle.world / shield_world.world.
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Startup camera: gzclient reads this once at launch, replacing Gazebo's
         stock default view. Symmetric third-person operator view: centered on
         the robot's own y=0 centerline (zero yaw, zero roll), directly behind
         the spawn point (x=-1.5) and a bit above head height (z=2.0), pitched
         down ~24 deg to look forward along +x: how someone standing behind
         the robot and looking over it would actually see the workspace.
         Reposition by hand in gzclient, then File > Save World As over this
         file to bake in your own preferred pose instead. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-1.50 0.00 1.85 0 0.41 0.00</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         RACK + CONVEYOR HANDOVER SCENARIO (TRIAGo)
         Storage rack over the work table forces SIDE grasps (its shelf
         underside blocks the top-grasp corridor over both cylinders).
         New station: a CONVEYOR on the robot's right (negative y) carrying
         the Final placement disk.

         TASK: both batteries must end on the conveyor's Final station. The
         RIGHT arm picks the red battery straight off the table and carries
         it to the conveyor. The BLUE battery sits on the left, out of the
         conveyor's reach for the left arm, so the LEFT arm sets it on the
         Handover disk (table centreline) and the RIGHT arm relays it to the
         conveyor. No divider: the handover is forced by reach, not an obstacle.

         LOAD-BEARING GEOMETRY:
           work table   top z=0.70            x[0.70,1.30]  y[-0.25,0.25]
           rack shelf   underside z=1.10       x[0.67,1.33]  y[-0.47,0.47]
           conveyor     belt top z=0.70 (== table top)  x[0.45,1.75]  y[-1.08,-0.72]
                        collision envelope: box [1.10,-0.90,0.35] size [1.30,0.48,0.70]
           Handover     [1.03,-0.01,0.701]  r=0.09  (on the table centreline)
           Final        [0.650,-0.90,0.701] r=0.15  (on the conveyor belt)

         Run: ros2 launch triago_gazebo triago_gazebo.launch.py ... world_name:=rack_world
         Mirrors config/worlds/rack_world.yaml (CBF/collision model) - keep
         both in sync by hand; decorative scenery below is visual-only and
         deliberately absent from the YAML.
    ================================================================ -->

    <!-- ================================================================
         WORK TABLE: same pose, size, and material as no_obstacle.world.
    ================================================================ -->
    <model name="work_table">
      <static>true</static>
      <pose>1.000 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- HANDOVER platform (yellow): on the table centreline (y=-0.01, disk
         spanning y[-0.10,+0.08]) and near the front table edge (x[0.94,1.12]),
         so BOTH arms reach it in a comfortable, non-extended posture - the left
         arm sets the blue cylinder here for the right hand to relay onward. The
         handover is forced by reach, not by an obstacle: the conveyor's Final
         station stays far outside the left arm's workspace. Clearances: 0.19 m
         to the front-center rack leg, 0.19 m to the red cylinder, 0.20 m to the
         blue one, and the whole disk sits on the table (x>=0.70). -->
    <model name="placement_area">
      <static>true</static>
      <pose>1.03 -0.01 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.09</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- FINAL platform (green): on the conveyor belt, inside its
         [-1.03,-0.67] width with a 0.03 m margin on each side. -->
    <model name="placement_area_final">
      <static>true</static>
      <pose>0.650 -0.90 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         RED CYLINDER, right arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="red_cylinder">
      <static>false</static>
      <pose>0.800 -0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>

        <!-- Battery-look details (visual only): grey top cap, gold terminal
             nub (protrudes 8mm above the body's top face z=0.075 - the only
             element outside the body envelope), dark-grey bottom cap, black
             label bands + white label patch. -->
        <visual name="cap_top">
          <pose>0 0 0.068 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.014</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="terminal_nub">
          <pose>0 0 0.079 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.008</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Gold</name></script></material>
        </visual>
        <visual name="cap_bottom">
          <pose>0 0 -0.069 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.012</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="label_band_top">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.010</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_band_bottom">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.010</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_patch">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><cylinder><radius>0.0207</radius><length>0.030</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BLUE CYLINDER, left arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="blue_cylinder">
      <static>false</static>
      <pose>0.800 0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <!-- Battery-look details (visual only): same accent styling as
             red_cylinder; only the body color differs. -->
        <visual name="cap_top">
          <pose>0 0 0.068 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.014</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="terminal_nub">
          <pose>0 0 0.079 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.008</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Gold</name></script></material>
        </visual>
        <visual name="cap_bottom">
          <pose>0 0 -0.069 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.012</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="label_band_top">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.010</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_band_bottom">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.010</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_patch">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><cylinder><radius>0.0207</radius><length>0.030</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         STORAGE RACK: new for this world. A shelf carried by TWO rear posts
         (on the floor behind the table) PLUS ONE front-center post that stands
         ON THE TABLE at the front edge, centered between the two cylinders, so
         the table carries it and it props the front of the shelf. (The original
         floor-standing FRONT corner posts were removed: they sat near the robot
         and collided with it at spawn.) The shelf underside sits ~0.40 m above
         the table top (z = 1.10), directly over BOTH cylinders, forming a
         ceiling that blocks the vertical top-grasp corridor, so the operator
         must grasp the cylinders from the SIDE. Matches config/worlds/
         rack_world.yaml's rack_* entries exactly (absolute poses; the model
         pose below is the world origin so every sub-pose is absolute).
    ================================================================ -->
    <model name="storage_rack">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- Horizontal shelf (ceiling over the cylinders), underside at z=1.10 -->
        <collision name="shelf_col">
          <pose>1.00 0.0 1.12 0 0 0</pose>
          <geometry><box><size>0.66 0.94 0.04</size></box></geometry>
        </collision>
        <visual name="shelf_vis">
          <pose>1.00 0.0 1.12 0 0 0</pose>
          <geometry><box><size>0.66 0.94 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <!-- Two REAR vertical legs, floor (z=0) up to the shelf underside (z=1.10).
             Front legs removed (collided with the robot at spawn); the shelf now
             cantilevers forward from these rear posts. -->
        <collision name="leg_bl_col">
          <pose>1.30 -0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
        </collision>
        <visual name="leg_bl_vis">
          <pose>1.30 -0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <collision name="leg_br_col">
          <pose>1.30 0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
        </collision>
        <visual name="leg_br_vis">
          <pose>1.30 0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- Front-center support post: stands ON THE TABLE (base at the table top
             z=0.70) at the front edge, centered between the two cylinders (y=0),
             so the table carries it. Props up the front of the cantilevered shelf.
             Front face flush with the table edge (x=0.70); footprint fully on the
             table (x in [0.70,0.75]). Height 0.40 (table top z=0.70 -> shelf z=1.10). -->
        <collision name="leg_fc_col">
          <pose>0.725 0.0 0.90 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.40</size></box></geometry>
        </collision>
        <visual name="leg_fc_vis">
          <pose>0.725 0.0 0.90 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

      </link>
    </model>

    <!-- ================================================================
         CONVEYOR: single CBF collision envelope (belt top flush with the
         table top plane, z=0.70) carrying a generous visual-only shell -
         belt, drums, side frames, rollers, legs, motor and an e-stop. Every
         visual below stays inside the envelope box [0.45,1.75]x[-1.14,-0.66]
         and never crosses z=0.70 over the belt (the end drums' rims are
         flush with 0.70, not above it). Matches config/worlds/rack_world.yaml's
         "conveyor" entry exactly (only the collision box is mirrored there).
    ================================================================ -->
    <model name="conveyor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- Whole conveyor shifted +0.05 m in x (5 cm further from the robot)
             and -0.05 m in y (5 cm further right), on top of the earlier
             -0.30 m x shift: envelope now [0.45,1.75] x [-1.14,-0.66]. z and
             every relative dimension are unchanged; matches rack_world.yaml's
             conveyor envelope pose. -->
        <collision name="col">
          <pose>1.10 -0.90 0.35 0 0 0</pose>
          <geometry><box><size>1.30 0.48 0.70</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="belt_slab">
          <pose>1.10 -0.90 0.690 0 0 0</pose>
          <geometry><box><size>1.30 0.36 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>

        <!-- End drums: axis along y (roll=90deg), length == belt width, rims
             flush with the belt top (z=0.70). Radius pokes ~1cm past the
             envelope's x ends - realistic (real idler drums overhang the
             frame slightly) and still visual-only. -->
        <visual name="drum_near">
          <pose>0.485 -0.90 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.36</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="drum_far">
          <pose>1.715 -0.90 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.36</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <visual name="frame_near">
          <pose>1.10 -0.70 0.640 0 0 0</pose>
          <geometry><box><size>1.30 0.04 0.12</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="frame_far">
          <pose>1.10 -1.10 0.640 0 0 0</pose>
          <geometry><box><size>1.30 0.04 0.12</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>

        <!-- Roller ends through the near frame (belt-side face), 8x spaced 0.13 m. -->
        <visual name="roller_1">
          <pose>0.60 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_2">
          <pose>0.73 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_3">
          <pose>0.86 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_4">
          <pose>0.99 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_5">
          <pose>1.12 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_6">
          <pose>1.25 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_7">
          <pose>1.38 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_8">
          <pose>1.51 -0.675 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- 4 legs: top (z=0.58) flush with the side frames' underside. -->
        <visual name="leg_fl">
          <pose>0.57 -0.73 0.29 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.58</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="leg_fr">
          <pose>0.57 -1.07 0.29 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.58</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="leg_bl">
          <pose>1.63 -0.73 0.29 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.58</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="leg_br">
          <pose>1.63 -1.07 0.29 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.58</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <visual name="brace_near">
          <pose>0.57 -0.90 0.08 0 0 0</pose>
          <geometry><box><size>0.04 0.36 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="brace_far">
          <pose>1.63 -0.90 0.08 0 0 0</pose>
          <geometry><box><size>0.04 0.36 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>

        <visual name="motor_housing">
          <pose>1.65 -0.90 0.60 0 0 0</pose>
          <geometry><box><size>0.10 0.14 0.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="motor_gearbox">
          <pose>1.58 -0.90 0.60 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.08</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <visual name="estop_plate">
          <pose>0.57 -0.695 0.45 0 0 0</pose>
          <geometry><box><size>0.015 0.05 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="estop_button">
          <pose>0.57 -0.685 0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>

      </link>
    </model>

    <!-- ================================================================
         INDUSTRIAL CELL SCENERY (visual only, no <collision> anywhere below -
         none of it is in rack_world.yaml). Everything stays >=1.3 m
         horizontally from the robot origin EXCEPT the overhead gantry beam
         and its ceiling lights: those exist only above z=2.3 m, well above
         any reachable height, so their horizontal position doesn't matter -
         it's the gantry's support COLUMNS (floor to ceiling) that keep the
         1.3 m clearance instead. Cell footprint: back wall x=2.4/2.6,
         side fences/walls y=+-1.4/+-1.6, open at the front (robot side).
    ================================================================ -->

    <!-- Paper-thin floor decal (z~1mm): not a 3D obstacle, so it's allowed
         to run under the robot - ground_plane already provides the real
         floor collision; this is purely a painted-floor look. -->
    <model name="cell_floor">
      <static>true</static>
      <pose>1.2 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>2.8 3.2 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Hazard-stripe border along the fenced perimeter (back/left/right; the
         front stays open, matching the fence). -->
    <model name="cell_hazard_stripes">
      <static>true</static>
      <pose>0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="back_1"><pose>2.35 -1.00 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="back_2"><pose>2.35 -0.60 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>
        <visual name="back_3"><pose>2.35 -0.20 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="back_4"><pose>2.35 0.20 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>
        <visual name="back_5"><pose>2.35 0.60 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="back_6"><pose>2.35 1.00 0 0 0 0</pose><geometry><box><size>0.10 0.40 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>

        <visual name="left_1"><pose>0.80 1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="left_2"><pose>1.20 1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>
        <visual name="left_3"><pose>1.60 1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="left_4"><pose>2.00 1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>

        <visual name="right_1"><pose>0.80 -1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="right_2"><pose>1.20 -1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>
        <visual name="right_3"><pose>1.60 -1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material></visual>
        <visual name="right_4"><pose>2.00 -1.35 0 0 0 0</pose><geometry><box><size>0.40 0.10 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material></visual>
      </link>
    </model>

    <!-- Safety guard fence: posts + 2 rails, back/left/right, open at the
         front (robot side). Nearest post to the origin is 1.36 m out.
         DarkGrey (not the ZincYellow used on the conveyor's own frame/braces)
         so the fence reads as structural steel, not a second hazard marking. -->
    <model name="safety_fence">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="post_back_1"><pose>2.40 -1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_back_2"><pose>2.40 -0.70 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_back_3"><pose>2.40 0.00 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_back_4"><pose>2.40 0.70 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_back_5"><pose>2.40 1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_left_1"><pose>0.60 1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_left_2"><pose>1.50 1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_right_1"><pose>0.60 -1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="post_right_2"><pose>1.50 -1.40 0 0 0 0</pose><geometry><box><size>0.04 0.04 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <visual name="rail_back_top"><pose>2.40 0.0 0.4 0 0 0</pose><geometry><box><size>0.03 2.80 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="rail_back_bottom"><pose>2.40 0.0 -0.2 0 0 0</pose><geometry><box><size>0.03 2.80 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="rail_left_top"><pose>1.50 1.40 0.4 0 0 0</pose><geometry><box><size>1.80 0.03 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="rail_left_bottom"><pose>1.50 1.40 -0.2 0 0 0</pose><geometry><box><size>1.80 0.03 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="rail_right_top"><pose>1.50 -1.40 0.4 0 0 0</pose><geometry><box><size>1.80 0.03 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="rail_right_bottom"><pose>1.50 -1.40 -0.2 0 0 0</pose><geometry><box><size>1.80 0.03 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <!-- Back/side wall panels, set back 0.2 m behind the fence for depth.
         Flat Grey (matches cell_floor), not the textured PaintedWall material:
         that texture has a yellow-to-orange gradient baked into the image
         itself (cream at the top fading to burnt-orange at the bottom), which
         reads as a lighting artifact but isn't one. -->
    <model name="cell_walls">
      <static>true</static>
      <pose>0 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="wall_back"><pose>2.60 0.0 0 0 0 0</pose><geometry><box><size>0.05 3.2 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <visual name="wall_left"><pose>1.55 1.60 0 0 0 0</pose><geometry><box><size>2.10 0.05 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <visual name="wall_right"><pose>1.55 -1.60 0 0 0 0</pose><geometry><box><size>2.10 0.05 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Overhead gantry: 2 floor-to-ceiling columns (respect the 1.3 m rule)
         carry a back beam, a cantilever beam over the table, a branch beam
         over the conveyor, a cable tray, and 2 light-fixture housings. The
         beams/tray/fixtures sit at z>=2.35 m - above any reachable height -
         which is why they're allowed to run out over the workspace: the
         ceiling lights need to actually be above what they light. -->
    <model name="overhead_gantry">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="column_left">
          <pose>2.30 1.30 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="column_right">
          <pose>2.30 -1.30 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="beam_back">
          <pose>2.30 0.0 2.45 0 0 0</pose>
          <geometry><box><size>0.10 2.70 0.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="beam_centerline">
          <pose>1.55 0.0 2.45 0 0 0</pose>
          <geometry><box><size>1.50 0.10 0.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="beam_branch_conveyor">
          <pose>1.45 -0.45 2.45 0 0 0</pose>
          <geometry><box><size>0.10 0.90 0.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="cable_tray">
          <pose>1.55 0.0 2.38 0 0 0</pose>
          <geometry><box><size>1.40 0.15 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="light_fixture_table">
          <pose>1.00 0.0 2.38 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WhiteGlow</name></script></material>
        </visual>
        <visual name="light_fixture_conveyor">
          <pose>1.45 -0.90 2.38 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WhiteGlow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Real point lights matching the fixture housings above (modest
         attenuation - meant to lift the render, not floodlight it). -->
    <light type="point" name="ceiling_light_table">
      <pose>1.00 0.0 2.30 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="ceiling_light_conveyor">
      <pose>1.45 -0.90 2.30 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Control cabinet: body + HMI screen + 3 pilot lights. -->
    <model name="control_cabinet">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <pose>2.20 1.20 0.70 0 0 0</pose>
          <geometry><box><size>0.5 0.4 1.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="hmi_panel">
          <pose>1.94 1.20 1.00 0 0 0</pose>
          <geometry><box><size>0.02 0.25 0.20</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material>
        </visual>
        <visual name="indicator_red">
          <pose>1.94 1.10 1.15 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/RedGlow</name></script></material>
        </visual>
        <visual name="indicator_yellow">
          <pose>1.94 1.15 1.15 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/YellowGlow</name></script></material>
        </visual>
        <visual name="indicator_green">
          <pose>1.94 1.20 1.15 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/GreenGlow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Andon / stack tower light on a post. -->
    <model name="andon_tower">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>1.80 1.30 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="lens_green">
          <pose>1.80 1.30 1.55 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/GreenGlow</name></script></material>
        </visual>
        <visual name="lens_yellow">
          <pose>1.80 1.30 1.65 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/YellowGlow</name></script></material>
        </visual>
        <visual name="lens_red">
          <pose>1.80 1.30 1.75 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/RedGlow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Pallet + crate stack (staging area). -->
    <model name="pallet_stack">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="pallet">
          <pose>2.20 -1.20 0.04 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
        <visual name="crate_1">
          <pose>2.05 -1.20 0.23 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.30</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <visual name="crate_2">
          <pose>2.35 -1.20 0.23 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.30</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <visual name="crate_top">
          <pose>2.20 -1.20 0.53 0 0 0.4</pose>
          <geometry><box><size>0.32 0.32 0.28</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Wall-mounted battery charging rack, echoing the Task-1 battery look. -->
    <model name="battery_charging_rack">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="shelf">
          <pose>1.00 1.50 0.90 0 0 0</pose>
          <geometry><box><size>0.9 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="bracket_left">
          <pose>0.60 1.50 0.825 0 0 0</pose>
          <geometry><box><size>0.03 0.10 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="bracket_right">
          <pose>1.40 1.50 0.825 0 0 0</pose>
          <geometry><box><size>0.03 0.10 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="battery_1">
          <pose>0.65 1.50 0.96 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.09</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
