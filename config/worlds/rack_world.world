<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: same tuning as no_obstacle.world / shield_world.world.
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         WORK TABLE: same pose, size, and material as no_obstacle.world.
    ================================================================ -->
    <model name="work_table">
      <static>true</static>
      <pose>1.000 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual placement manifold (Yellow Area), no collision, same as
         no_obstacle.world. NOTE: it sits UNDER the rack shelf in this world,
         so placement (like grasping) must be done from the side, not the top. -->
    <model name="placement_area">
      <static>true</static>
      <pose>1.000 0.0 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         RED CYLINDER, right arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="red_cylinder">
      <static>false</static>
      <pose>0.800 -0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BLUE CYLINDER, left arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="blue_cylinder">
      <static>false</static>
      <pose>0.800 0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         STORAGE RACK: new for this world. A shelf carried by TWO rear posts
         (on the floor behind the table) PLUS ONE front-center post that stands
         ON THE TABLE at the front edge, centered between the two cylinders, so
         the table carries it and it props the front of the shelf. (The original
         floor-standing FRONT corner posts were removed: they sat near the robot
         and collided with it at spawn.) The shelf underside sits ~0.40 m above
         the table top (z = 1.10), directly over BOTH cylinders, forming a
         ceiling that blocks the vertical top-grasp corridor, so the operator
         must grasp the cylinders from the SIDE. Matches config/worlds/
         rack_world.yaml's rack_* entries exactly (absolute poses; the model
         pose below is the world origin so every sub-pose is absolute).
    ================================================================ -->
    <model name="storage_rack">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- Horizontal shelf (ceiling over the cylinders), underside at z=1.10 -->
        <collision name="shelf_col">
          <pose>1.00 0.0 1.12 0 0 0</pose>
          <geometry><box><size>0.66 0.94 0.04</size></box></geometry>
        </collision>
        <visual name="shelf_vis">
          <pose>1.00 0.0 1.12 0 0 0</pose>
          <geometry><box><size>0.66 0.94 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <!-- Two REAR vertical legs, floor (z=0) up to the shelf underside (z=1.10).
             Front legs removed (collided with the robot at spawn); the shelf now
             cantilevers forward from these rear posts. -->
        <collision name="leg_bl_col">
          <pose>1.30 -0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
        </collision>
        <visual name="leg_bl_vis">
          <pose>1.30 -0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <collision name="leg_br_col">
          <pose>1.30 0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
        </collision>
        <visual name="leg_br_vis">
          <pose>1.30 0.42 0.55 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.10</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- Front-center support post: stands ON THE TABLE (base at the table top
             z=0.70) at the front edge, centered between the two cylinders (y=0),
             so the table carries it. Props up the front of the cantilevered shelf.
             Front face flush with the table edge (x=0.70); footprint fully on the
             table (x in [0.70,0.75]). Height 0.40 (table top z=0.70 -> shelf z=1.10). -->
        <collision name="leg_fc_col">
          <pose>0.725 0.0 0.90 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.40</size></box></geometry>
        </collision>
        <visual name="leg_fc_vis">
          <pose>0.725 0.0 0.90 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

      </link>
    </model>

  </world>
</sdf>
