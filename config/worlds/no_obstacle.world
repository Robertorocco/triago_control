<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: ODE tuned for stable gripper-cylinder contact AND
         realistic cylinder-on-table behaviour (no infinite lean).
           - erp 0.2 -> 0.5: firmer position correction so a tilted cylinder
             actually resolves (topples or settles) instead of freezing
           - contact_max_correcting_vel 0.5 -> 2.0: lets the solver apply
             enough corrective velocity to resolve a tipping contact
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         WORK TABLE: static surface. Friction lowered from mu=10 (unrealistic,
         acted like glue on a tilted cylinder's rim edge, faking a stable
         "leaning forever" pose) to a realistic wood/rubber-like value. The
         grasp itself does not depend on table friction (LinkAttacher performs
         a kinematic weld), so lowering this is safe for grasping and only
         affects standing/tipping realism.
    ================================================================ -->
    <model name="work_table">
      <static>true</static>
      <pose>1.000 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.5 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual placement manifold (Yellow Area) — no collision, unchanged -->
    <model name="placement_area">
      <static>true</static>
      <pose>1.000 0.0 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         RED CYLINDER — right arm manipulandum.
         Geometry UNCHANGED: radius=0.02m, length=0.15m, pose unchanged.

         Now made IDENTICAL to the blue cylinder (mass/inertia/contact/friction),
         since the earlier mismatch (red had no contact-ODE block and a
         different mass) made the two behave inconsistently. Contact stiffness
         raised (kp 5000 -> 20000) so a tipping cylinder resolves promptly
         instead of lingering at an unstable tilt; friction lowered to a
         realistic value (mu 1.0 -> 0.6) since the grasp itself does not rely
         on table friction (LinkAttacher weld).
    ================================================================ -->
    <model name="red_cylinder">
      <static>false</static>
      <pose>0.800 -0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BLUE CYLINDER — left arm manipulandum.
         Identical mass/inertia/contact/friction to the red cylinder (see above).
    ================================================================ -->
    <model name="blue_cylinder">
      <static>false</static>
      <pose>0.800 0.20 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
