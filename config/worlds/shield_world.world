<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="bimanual_manipulation_world">

    <!-- ================================================================
         PHYSICS: same tuning as no_obstacle.world and rack_world.world.
    ================================================================ -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.5</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Startup camera: gzclient reads this once at launch, replacing Gazebo's
         stock default view. Symmetric third-person operator view: centered on
         the robot's own y=0 centerline (zero yaw, zero roll), directly behind
         the spawn point (x=-1.5) and a bit above head height (z=2.0), pitched
         down ~24 deg to look forward along +x: how someone standing behind
         the robot and looking over it would actually see the workspace.
         Reposition by hand in gzclient, then File > Save World As over this
         file to bake in your own preferred pose instead. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-1.50 0.00 1.85 0 0.41 0.00</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>

    <!-- Standard illumination and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================================
         SHIELDED TWIN-CONVEYOR SCENARIO (TRIAGo)
         A glass safety shield stands between the robot and the table,
         spanning the table's FULL width, so the frontal approach is closed
         everywhere along it and every grasp has to clear the pane's top edge
         (z=0.82) before descending. Two conveyors flank the table, one on
         each side, mirror-symmetric about y=0, each carrying its own green
         Final placement disk and its own stock crate.

         TASK: the RIGHT arm picks the red battery and places it on Final_R,
         on the RIGHT conveyor. The LEFT arm picks the blue battery and
         places it on Final_L, on the LEFT conveyor. No handover, no rack.

         LOAD-BEARING GEOMETRY:
           work table       pose [1.010,0.0,0.325]  size [0.60,0.50,0.65]
                             top z=0.65  x[0.71,1.31]  y[-0.25,0.25]
           shield            model pose [0.71,0.00,0.65]; collision sub-pose
                             [0,0,0.035] size [0.02,0.50,0.27]
                             -> absolute collision box [0.71,0.00,0.685]
                             size [0.02,0.50,0.27], z[0.55,0.82] (base fixed,
                             3cm trimmed off the top), y[-0.25,0.25]: the
                             SAME width as the table, so no side window is
                             left beside it
           conveyor_right    collision envelope, sub-pose [1.10,-0.85,0.35]
                             size [1.30,0.48,0.70]  y[-1.09,-0.61]
           conveyor_left     collision envelope, sub-pose [1.10,0.85,0.35]
                             size [1.30,0.48,0.70]  y[0.61,1.09]  (exact
                             y-mirror of conveyor_right; x, z, rpy unchanged)
           Final_R           [0.680,-0.85,0.701]  r=0.15
           Final_L           [0.680,0.85,0.701]   r=0.15
           cylinders         x=0.810  y=+-0.20  z_center=0.730  length=0.16
                             (matches rack_world.world's battery height)

         Run: ros2 launch triago_gazebo triago_gazebo.launch.py ... world_name:=shield_world
         Mirrors config/worlds/shield_world.yaml (CBF/collision model) - keep
         both in sync by hand; decorative scenery below is visual-only and
         deliberately absent from the YAML.
    ================================================================ -->

    <!-- ================================================================
         WORK TABLE: full depth (x=0.60) - nothing sits behind it in this
         layout, both conveyors sit beside it instead.
    ================================================================ -->
    <model name="work_table">
      <static>true</static>
      <pose>1.010 0.0 0.325 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.60 0.50 0.65</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.50 0.65</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- FINAL_R platform (green): on the right conveyor belt, inside its
         [-1.03,-0.67] width with a 0.03 m margin on each side. -->
    <model name="placement_area_final_right">
      <static>true</static>
      <pose>0.680 -0.85 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- FINAL_L platform (green): the y-mirror of Final_R, on the left
         conveyor belt. -->
    <model name="placement_area_final_left">
      <static>true</static>
      <pose>0.680 0.85 0.701 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.002</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         RED CYLINDER, right arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="red_cylinder">
      <static>false</static>
      <pose>0.810 -0.20 0.730 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.16</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.16</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>

        <!-- Battery-look details (visual only): grey top cap, gold terminal
             nub (protrudes above the body's top face z=0.080 - the only
             element outside the body envelope), dark-grey bottom cap, black
             label bands + white label patch. -->
        <visual name="cap_top">
          <pose>0 0 0.0725 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.0149</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="terminal_nub">
          <pose>0 0 0.0843 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.0085</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Gold</name></script></material>
        </visual>
        <visual name="cap_bottom">
          <pose>0 0 -0.0736 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.0128</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="label_band_top">
          <pose>0 0 0.0373 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.0107</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_band_bottom">
          <pose>0 0 -0.0373 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.0107</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_patch">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><cylinder><radius>0.0207</radius><length>0.0320</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BLUE CYLINDER, left arm manipulandum. Same as no_obstacle.world.
    ================================================================ -->
    <model name="blue_cylinder">
      <static>false</static>
      <pose>0.810 0.20 0.730 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000309</ixx>
            <iyy>0.000309</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.02</radius><length>0.16</length></cylinder></geometry>
          <surface>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.5</soft_erp>
                <kp>20000</kp>
                <kd>50</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.02</radius><length>0.16</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <!-- Battery-look details (visual only): same accent styling as
             red_cylinder; only the body color differs. -->
        <visual name="cap_top">
          <pose>0 0 0.0725 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.0149</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="terminal_nub">
          <pose>0 0 0.0843 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.0085</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Gold</name></script></material>
        </visual>
        <visual name="cap_bottom">
          <pose>0 0 -0.0736 0 0 0</pose>
          <geometry><cylinder><radius>0.0205</radius><length>0.0128</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="label_band_top">
          <pose>0 0 0.0373 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.0107</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_band_bottom">
          <pose>0 0 -0.0373 0 0 0</pose>
          <geometry><cylinder><radius>0.0206</radius><length>0.0107</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="label_patch">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><cylinder><radius>0.0207</radius><length>0.0320</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         SAFETY SHIELD ASSEMBLY: static machine-guard panel standing at the
         table's front edge. Its width matches the table's exactly
         (y[-0.25,0.25]), so it closes the frontal approach across the WHOLE
         table: nothing reaches a cylinder without clearing the pane's top
         edge at z=0.82 first. The collision box is load-bearing (mirrored
         exactly in shield_world.yaml's "shield_obstacle") and every visual
         below is dressing built around it, carrying NO collision of its own:
         a steel frame (posts, top/bottom rails, two mullions splitting the
         glass into three panels), an inset glass pane, a 5-segment hazard
         band across the top, and two mounting feet below the table top.
    ================================================================ -->
    <model name="safety_shield_assembly">
      <static>true</static>
      <pose>0.71 0.00 0.65 0 0 0</pose>
      <link name="link">
        <collision name="shield_col">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><box><size>0.02 0.50 0.27</size></box></geometry>
        </collision>

        <!-- Steel frame: two side posts, top/bottom rails, two mullions. -->
        <visual name="post_left">
          <pose>0 0.24 0.035 0 0 0</pose>
          <geometry><box><size>0.025 0.02 0.27</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="post_right">
          <pose>0 -0.24 0.035 0 0 0</pose>
          <geometry><box><size>0.025 0.02 0.27</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="rail_top">
          <pose>0 0.0 0.16 0 0 0</pose>
          <geometry><box><size>0.025 0.50 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="rail_bottom">
          <pose>0 0.0 -0.09 0 0 0</pose>
          <geometry><box><size>0.025 0.50 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="mullion_left">
          <pose>0 0.153 0.035 0 0 0</pose>
          <geometry><box><size>0.022 0.015 0.23</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="mullion_right">
          <pose>0 -0.153 0.035 0 0 0</pose>
          <geometry><box><size>0.022 0.015 0.23</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- Inset glass pane, slightly smaller than the collision box so
             the frame reads as surrounding it. -->
        <visual name="glass_pane">
          <pose>0 0.0 0.035 0 0 0</pose>
          <geometry><box><size>0.012 0.46 0.23</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Glass</name></script></material>
        </visual>

        <!-- Hazard band across the top: 5 alternating segments spanning the
             full 0.50 m width. -->
        <visual name="hazard_1">
          <pose>0 -0.20 0.135 0 0 0</pose>
          <geometry><box><size>0.028 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="hazard_2">
          <pose>0 -0.10 0.135 0 0 0</pose>
          <geometry><box><size>0.028 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="hazard_3">
          <pose>0 0.00 0.135 0 0 0</pose>
          <geometry><box><size>0.028 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="hazard_4">
          <pose>0 0.10 0.135 0 0 0</pose>
          <geometry><box><size>0.028 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>
        <visual name="hazard_5">
          <pose>0 0.20 0.135 0 0 0</pose>
          <geometry><box><size>0.028 0.10 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>

        <!-- Mounting feet, below the table top so they stay out of the arm's path. -->
        <visual name="foot_left">
          <pose>0 0.24 -0.095 0 0 0</pose>
          <geometry><box><size>0.09 0.05 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="foot_right">
          <pose>0 -0.24 -0.095 0 0 0</pose>
          <geometry><box><size>0.09 0.05 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         CONVEYOR_RIGHT: CBF collision envelope (belt top flush with the
         belt top z=0.70) carrying a generous visual-only shell -
         belt, drums, side frames, rollers, legs, motor and an e-stop. Every
         visual below stays inside the envelope box [0.45,1.75]x[-1.09,-0.61]
         and never crosses z=0.70 over the belt. Matches config/worlds/
         shield_world.yaml's "conveyor_right" entry exactly (only the
         collision box is mirrored there). conveyor_left below is this same
         model with every sub-pose's y coordinate negated.
    ================================================================ -->
    <model name="conveyor_right">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <collision name="col">
          <pose>1.10 -0.85 0.35 0 0 0</pose>
          <geometry><box><size>1.30 0.48 0.70</size></box></geometry>
          <surface>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="belt_slab">
          <pose>1.10 -0.85 0.690 0 0 0</pose>
          <geometry><box><size>1.30 0.36 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/FlatBlack</name></script></material>
        </visual>

        <!-- End drums: axis along y (roll=90deg), length == belt width, rims
             flush with the belt top (z=0.70). Radius pokes ~1cm past the
             envelope's x ends - realistic (real idler drums overhang the
             frame slightly) and still visual-only. -->
        <visual name="drum_near">
          <pose>0.485 -0.85 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.36</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="drum_far">
          <pose>1.715 -0.85 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.36</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <visual name="frame_near">
          <pose>1.10 -0.65 0.640 0 0 0</pose>
          <geometry><box><size>1.30 0.04 0.12</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>
        <visual name="frame_far">
          <pose>1.10 -1.05 0.640 0 0 0</pose>
          <geometry><box><size>1.30 0.04 0.12</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/ZincYellow</name></script></material>
        </visual>

        <!-- Roller ends through the near frame (belt-side face), 8x spaced 0.13 m. -->
        <visual name="roller_1">
          <pose>0.60 -0.625 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_2">
          <pose>0.73 -0.625 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_3">
          <pose>0.86 -0.625 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_4">
          <pose>0.99 -0.625 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <visual name="roller_5">
          <pose>1.12 -0.625 0.655 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.02</length></cylinder></geometry>
