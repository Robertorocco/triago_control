__pycache__/
*.pyc
.claude/

# LaTeX build byproducts (the .tex sources are tracked, these aren't).
*.aux
*.log
*.out
*.bbl
*.blg
*.lof
*.lot
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
thesis/roberto_rocco_master_thesis/main.pdf

# User-study data (rosbags, per-trial timeseries, figures) must stay local,
# never committed. See scripts/analysis/study_config.py (DATA_ROOT). Guard in
# case the data root is ever pointed inside the repo.
triago_study_data/
*.bag
*.db3
*.mcap
*.parquet

# Generated by the MATLAB group analysis (build_report / run_study_analysis)
scripts/analysis/matlab/*.mlx
analysis_results/

# Videos and raw trial data never go to git.
*.mp4
*.MP4
*.mov
*.avi
*.mkv
*.webm
thesis/roberto_rocco_master_thesis/figures/results/Home-*Cross2/
thesis/roberto_rocco_master_thesis/figures/results/Real_Teleop_10_CFB_SUCCESS/*
!thesis/roberto_rocco_master_thesis/figures/results/Real_Teleop_10_CFB_SUCCESS/*_crop.jpeg
